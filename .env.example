# Database (Docker Compose & Local PostgreSQL)
POSTGRES_DB=artisanos
POSTGRES_USER=artisanos
POSTGRES_PASSWORD=artisanos_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Backend Django settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://artisanos:artisanos_dev_password@localhost:5432/artisanos
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FEATURE_CAMERA_MEASUREMENTS=False
PAYSTACK_SECRET_KEY=replace-with-paystack-secret-key-for-webhooks
PAYSTACK_PUBLIC_KEY=replace-with-paystack-public-key
FRONTEND_SITE_URL=http://localhost:3000

# Frontend Next.js settings
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
